{
  "name": "@lexiconlang/bases",
  "version": "0.1.0",
  "type": "module",
  "description": "Real-language-inspired base descriptors and cultures for LexiconLang (B1).",
  "license": "MIT",
  "sideEffects": false,
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./norse": {
      "types": "./dist/src/norse.d.ts",
      "import": "./dist/src/norse.js"
    },
    "./celtic": {
      "types": "./dist/src/celtic.d.ts",
      "import": "./dist/src/celtic.js"
    },
    "./latin": {
      "types": "./dist/src/latin.d.ts",
      "import": "./dist/src/latin.js"
    },
    "./greek": {
      "types": "./dist/src/greek.d.ts",
      "import": "./dist/src/greek.js"
    },
    "./japanese": {
      "types": "./dist/src/japanese.d.ts",
      "import": "./dist/src/japanese.js"
    },
    "./arabic": {
      "types": "./dist/src/arabic.d.ts",
      "import": "./dist/src/arabic.js"
    },
    "./slavic": {
      "types": "./dist/src/slavic.d.ts",
      "import": "./dist/src/slavic.js"
    },
    "./old-english": {
      "types": "./dist/src/old-english.d.ts",
      "import": "./dist/src/old-english.js"
    },
    "./persian": {
      "types": "./dist/src/persian.d.ts",
      "import": "./dist/src/persian.js"
    },
    "./sanskrit": {
      "types": "./dist/src/sanskrit.d.ts",
      "import": "./dist/src/sanskrit.js"
    },
    "./mandarin": {
      "types": "./dist/src/mandarin.d.ts",
      "import": "./dist/src/mandarin.js"
    },
    "./nahuatl": {
      "types": "./dist/src/nahuatl.d.ts",
      "import": "./dist/src/nahuatl.js"
    },
    "./yoruba": {
      "types": "./dist/src/yoruba.d.ts",
      "import": "./dist/src/yoruba.js"
    },
    "./polynesian": {
      "types": "./dist/src/polynesian.d.ts",
      "import": "./dist/src/polynesian.js"
    },
    "./ancient-egyptian": {
      "types": "./dist/src/ancient-egyptian.d.ts",
      "import": "./dist/src/ancient-egyptian.js"
    },
    "./finnish": {
      "types": "./dist/src/finnish.d.ts",
      "import": "./dist/src/finnish.js"
    },
    "./data/*": "./data/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "data",
    "README.md",
    "PROVENANCE.md",
    "package.json"
  ],
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run"
  },
  "dependencies": {
    "@lexiconlang/core": "workspace:*",
    "@lexiconlang/language": "workspace:*",
    "@lexiconlang/packs": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": "^22.13.0 || ^24.0.0 || >=26.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
