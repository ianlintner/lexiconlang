{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "types": ["node"],
    "paths": {
      "@lexicon/core": ["../core/src/index.ts"],
      "@lexicon/markov": ["../markov/src/index.ts"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["src/**/*.test.ts", "dist"],
  "references": [
    { "path": "../core" },
    { "path": "../markov" }
  ]
}
