{
  "name": "@lexiconlang/grimdark",
  "version": "0.1.0",
  "description": "Grimdark genre pack for lexiconlang — warbands, heresies, plagues, mutations, war machines, ratfolk clans and doom-laden battles",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./pack.json": "./data/grimdark.pack.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "data",
    "README.md",
    "data/PROVENANCE.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@lexiconlang/core": "workspace:*",
    "@lexiconlang/grammar": "workspace:*",
    "@lexiconlang/packs": "workspace:*"
  }
}
