{
  "name": "@content-gen/fantasy",
  "version": "0.1.0",
  "description": "Fantasy genre content pack for content-gen — races, names, places, factions",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "src", "README.md"],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@content-gen/core": "workspace:*",
    "@content-gen/grammar": "workspace:*",
    "@content-gen/language": "workspace:*",
    "@content-gen/markov": "workspace:*"
  }
}
