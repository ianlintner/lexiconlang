{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lexiconlang.dev/schemas/pack-v1.schema.json",
  "title": "LexiconLang declarative pack v1",
  "description": "Deterministic, portable world-pack manifest. CANONICAL_ID: https://lexiconlang.dev/schemas/pack-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["formatVersion", "id", "version", "license", "description", "provenance", "depends", "extends", "requires", "cultures", "meaningPacks", "grammars", "tables", "corpora", "markovModels", "generators"],
  "properties": {
    "$schema": { "type": "string" },
    "formatVersion": { "const": 1 },
    "id": { "$ref": "common-v1.schema.json#/$defs/packId" },
    "version": { "$ref": "common-v1.schema.json#/$defs/semver" },
    "license": { "type": "string", "minLength": 1 },
    "description": { "$ref": "common-v1.schema.json#/$defs/safeString" },
    "provenance": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "source", "title", "creator", "license", "attribution", "modifications", "files"],
        "properties": {
          "id": { "$ref": "common-v1.schema.json#/$defs/localId" },
          "source": { "type": "string", "minLength": 1 },
          "title": { "$ref": "common-v1.schema.json#/$defs/safeString" },
          "creator": { "$ref": "common-v1.schema.json#/$defs/safeString" },
          "license": { "type": "string", "minLength": 1 },
          "attribution": { "$ref": "common-v1.schema.json#/$defs/safeString" },
          "modifications": { "$ref": "common-v1.schema.json#/$defs/safeString" },
          "retrieved": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
          "files": { "$ref": "common-v1.schema.json#/$defs/stringArray" }
        }
      }
    },
    "depends": { "$ref": "#/$defs/dependencies" },
    "extends": { "$ref": "#/$defs/dependencies" },
    "requires": {
      "type": "array",
      "items": { "enum": ["language-v1", "grammar-v1", "tables-v1", "markov-v1", "bases-v1", "dialects-v1"] }
    },
    "cultures": { "type": "array", "items": { "$ref": "culture-v1.schema.json#/$defs/cultureData" } },
    "meaningPacks": { "type": "array", "items": { "$ref": "meaning-v1.schema.json#/$defs/meaningPackData" } },
    "grammars": { "type": "array", "items": { "$ref": "grammar-v1.schema.json#/$defs/grammarData" } },
    "tables": { "type": "array", "items": { "$ref": "table-v1.schema.json#/$defs/tableData" } },
    "corpora": { "type": "array", "items": { "$ref": "corpus-v1.schema.json#/$defs/corpusData" } },
    "markovModels": { "type": "array", "items": { "$ref": "corpus-v1.schema.json#/$defs/modelData" } },
    "generators": { "type": "array", "items": { "$ref": "generator-v1.schema.json#/$defs/generatorData" } },
    "bases": { "type": "array", "items": { "$ref": "base-v1.schema.json#/$defs/baseData" } },
    "dialects": { "type": "array", "items": { "$ref": "dialect-v1.schema.json#/$defs/dialectData" } },
    "extensions": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/json" }
    }
  },
  "$defs": {
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "version"],
        "properties": {
          "id": { "$ref": "common-v1.schema.json#/$defs/packId" },
          "version": { "type": "string", "pattern": "^(\\^?)(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$" }
        }
      }
    },
    "json": {
      "oneOf": [
        { "type": "null" },
        { "type": "boolean" },
        { "type": "integer" },
        { "type": "number" },
        { "type": "string" },
        { "type": "array", "items": { "$ref": "#/$defs/json" } },
        { "type": "object", "additionalProperties": { "$ref": "#/$defs/json" } }
      ]
    }
  }
}
