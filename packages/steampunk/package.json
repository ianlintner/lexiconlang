{
  "name": "@lexiconlang/steampunk",
  "version": "0.1.0",
  "description": "Steampunk and gaslamp genre pack for lexiconlang — inventors, airships, guilds, districts, automatons, patent titles and newspaper headlines",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./pack.json": "./data/steampunk.pack.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "data",
    "README.md",
    "PROVENANCE.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@lexiconlang/core": "workspace:*",
    "@lexiconlang/grammar": "workspace:*",
    "@lexiconlang/packs": "workspace:*"
  }
}
