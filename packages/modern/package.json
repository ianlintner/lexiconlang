{
  "name": "@lexicon/modern",
  "version": "0.1.0",
  "description": "Modern-day genre content pack for content-gen — names, cities, companies, streets",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "src", "README.md"],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@lexicon/core": "workspace:*",
    "@lexicon/grammar": "workspace:*"
  }
}
