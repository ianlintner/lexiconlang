{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "composite": false,
    "incremental": false,
    "paths": {
      "@content-gen/core": ["../packages/core/src/index.ts"],
      "@content-gen/grammar": ["../packages/grammar/src/index.ts"],
