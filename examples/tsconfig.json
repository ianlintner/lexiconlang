      "@content-gen/fantasy": ["../packages/fantasy/src/index.ts"],
      "@content-gen/scifi": ["../packages/scifi/src/index.ts"],
      "@content-gen/modern": ["../packages/modern/src/index.ts"]
    }
  },
  "include": ["./**/*.ts"]
